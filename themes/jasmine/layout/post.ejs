<!-- ═══════════════════════════════════════════
   TOC: 将 Hexo 扁平 TOC 重建为可折叠树
   ═══════════════════════════════════════════ -->
<script>
(function() {
  var toc = document.getElementById('toc');
  if (!toc) return;

  var flatOl = toc.querySelector('ol.toc');
  if (!flatOl) return;

  // 1. 解析扁平 TOC，构建层级树
  var flatItems = Array.from(flatOl.querySelectorAll('li.toc-item'));
  if (!flatItems.length) return;

  function getLevel(li) {
    var match = (li.className || '').match(/toc-level-(\d+)/);
    return match ? parseInt(match[1], 10) : 2;
  }

  // 构建树节点 { level, link, text, children }
  var root = { level: 1, children: [] };
  var stack = [root];  // 祖先链，stack[stack.length-1] 是当前父节点

  flatItems.forEach(function(li) {
    var level = getLevel(li);
    var link = li.querySelector('a.toc-link');
    var href = link ? link.getAttribute('href') : '';
    var text = link ? (link.querySelector('.toc-text') ? link.querySelector('.toc-text').textContent : link.textContent) : '';

    var node = { level: level, href: href, text: text, children: [] };

    // 找到父节点：向上找 stack 中 level < node.level 的最近节点
    while (stack.length > 1 && stack[stack.length - 1].level >= level) {
      stack.pop();
    }
    var parent = stack[stack.length - 1];
    parent.children.push(node);
    stack.push(node);
  });

  // 2. 从树构建 DOM
  function buildOl(children, parentLevel) {
    if (!children.length) return null;
    var ol = document.createElement('ol');
    ol.className = 'toc-children';
    ol.style.listStyle = 'none';
    ol.style.paddingLeft = '0';
    children.forEach(function(node) {
      var li = document.createElement('li');
      li.className = 'toc-item toc-level-' + node.level;

      var inner = document.createElement('div');
      inner.className = 'toc-item-inner';

      var hasChildren = node.children.length > 0;

      // Toggle 按钮（仅对有子项的节点）
      if (hasChildren) {
        var toggle = document.createElement('span');
        toggle.className = 'toc-toggle';
        toggle.textContent = '▾';
        toggle.setAttribute('aria-expanded', 'true');
        inner.appendChild(toggle);
      } else {
        // 占位，保持对齐
        var spacer = document.createElement('span');
        spacer.className = 'toc-toggle';
        spacer.style.cssText = 'visibility:hidden;';
        inner.appendChild(spacer);
      }

      var a = document.createElement('a');
      a.className = 'toc-link';
      a.href = node.href;
      a.textContent = node.text;
      inner.appendChild(a);
      li.appendChild(inner);

      // 递归构建子级
      var childOl = buildOl(node.children, node.level);
      if (childOl) {
        li.appendChild(childOl);
      }

      ol.appendChild(li);
    });
    return ol;
  }

  var newOl = buildOl(root.children, 1);

  // 3. 替换扁平 TOC
  if (newOl) {
    newOl.classList.add('toc');
    // 根 ol 不需要 toc-children 的 overflow:hidden，否则会裁剪内容
    newOl.classList.remove('toc-children');
    newOl.style.listStyle = 'none';
    newOl.style.paddingLeft = '0';
    flatOl.parentNode.replaceChild(newOl, flatOl);

    // 辅助：向上更新所有祖先 ol.toc-children 的 max-height
    function updateAncestorHeights(childOl) {
      childOl.offsetHeight; // 强制子级完成布局
      var parentLi = childOl.closest('li.toc-item');
      while (parentLi) {
        var ancestorOl = parentLi.closest('ol.toc-children');
        if (!ancestorOl || ancestorOl === newOl) break;
        if (!ancestorOl.classList.contains('collapsed')) {
          ancestorOl.style.maxHeight = ancestorOl.scrollHeight + 'px';
        }
        parentLi = ancestorOl.closest('li.toc-item');
      }
    }

    // 4. 绑定折叠事件
    newOl.addEventListener('click', function(e) {
      var toggle = e.target.closest('.toc-toggle');
      if (!toggle) return;
      var li = toggle.closest('.toc-item');
      if (!li) return;
      var childOl = li.querySelector(':scope > ol.toc-children');
      if (!childOl) return;

      var isCollapsed = childOl.classList.contains('collapsed');
      if (isCollapsed) {
        // ── 展开 ──
        // 优先使用折叠时保存的高度；否则临时解除约束后测量
        var targetH = parseFloat(childOl.dataset.expandedH);
        if (!targetH) {
          childOl.classList.remove('collapsed');
          childOl.style.maxHeight = 'none';
          childOl.style.overflow = 'visible';
          targetH = childOl.scrollHeight;
          childOl.classList.add('collapsed');
          childOl.style.overflow = '';
        }
        childOl.classList.remove('collapsed');
        childOl.style.maxHeight = targetH + 'px';
        childOl.style.overflow = '';
        updateAncestorHeights(childOl);
        toggle.classList.remove('collapsed');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = '▾';
      } else {
        // ── 折叠 ──
        var expandedH = childOl.scrollHeight;
        childOl.dataset.expandedH = expandedH;
        childOl.style.maxHeight = expandedH + 'px';
        childOl.offsetHeight; // 锁定过渡起点
        childOl.classList.add('collapsed');
        // 不设 inline max-height:0，由 CSS .collapsed !important 接管
        updateAncestorHeights(childOl);
        toggle.classList.add('collapsed');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = '▸';
      }
    });

    // 初始化：所有展开
    var allChildren = newOl.querySelectorAll('ol.toc-children');
    allChildren.forEach(function(ol) {
      ol.style.maxHeight = ol.scrollHeight + 'px';
    });
  }
})();
</script>
<div class="content content-post CENTER">
  <article id="post-<%= page.slug %>" class="article" itemscope itemtype="http://schema.org/BlogPosting">

    <header class="article-header">
      <h1 class="post-title"><%= page.title %></h1>

      <div class="article-meta">
        <span class="meta-item">
          <i class="meta-icon">&#x1F4C5;</i>
          <span><%= page.date.format('YYYY.MM.DD') %></span>
        </span>

        <% var displayAuthor = page.author || config.author; %>
        <% if (displayAuthor) { %>
        <span class="meta-sep">·</span>
        <span class="meta-item">
          <i class="meta-icon">&#x270D;</i>
          <span><%= displayAuthor %></span>
        </span>
        <% } %>

        <% if (page.categories && page.categories.length > 0) { %>
        <span class="meta-sep">·</span>
        <span class="meta-item">
          <i class="meta-icon">&#x1F4C2;</i>
          <% page.categories.each(function(cat) { %>
          <a class="article-category-link" href="/categories/#<%= encodeURIComponent(cat.name) %>"><%= cat.name %></a><% if (page.categories.last().name !== cat.name) { %>, <% } %>
          <% }); %>
        </span>
        <% } %>
      </div>

      <% if (page.tags && page.tags.length > 0) { %>
      <div class="article-tags">
        <% page.tags.each(function(tag) { %>
        <a class="article-tag" href="/tags/#<%= encodeURIComponent(tag.name.replace(/^#/, '')) %>"><%= tag.name.replace(/^#/, '') %></a>
        <% }); %>
      </div>
      <% } %>
    </header>

    <div class="article-content">
      <%- page.content %>
    </div>

  </article>

  <!-- ── 上一篇 / 下一篇 ── -->
  <div class="box-prev-next clearfix">
    <% if (page.prev) { %>
    <a class="show pull-left" href="<%= url_for(page.prev.path) %>" title="<%= page.prev.title %>">
      ◀
    </a>
    <% } else { %>
    <a class="hide pull-left">◀</a>
    <% } %>
    <% if (page.next) { %>
    <a class="show pull-right" href="<%= url_for(page.next.path) %>" title="<%= page.next.title %>">
      ▶
    </a>
    <% } else { %>
    <a class="hide pull-right">▶</a>
    <% } %>
  </div>

</div>

<!-- ── 将侧边栏与正文内容对齐 ── -->
<script>
(function() {
  var sidebar = document.querySelector('.post-sidebar');
  var articleContent = document.querySelector('.article-content');
  if (sidebar && articleContent) {
    var top = articleContent.getBoundingClientRect().top + window.scrollY;
    sidebar.style.top = top + 'px';
  }
})();
</script>

<!-- ── Giscus 评论区 ── -->
<% if (theme.giscus && theme.giscus.enable && theme.giscus.repo_id) { %>
<div class="fexo-comments comments-post">
  <section class="giscus-comments">
    <script src="https://giscus.app/client.js"
      data-repo="<%= theme.giscus.repo %>"
      data-repo-id="<%= theme.giscus.repo_id %>"
      data-category="<%= theme.giscus.category %>"
      data-category-id="<%= theme.giscus.category_id %>"
      data-mapping="<%= theme.giscus.mapping || 'pathname' %>"
      data-strict="<%= theme.giscus.strict || '0' %>"
      data-reactions-enabled="<%= theme.giscus.reactions_enabled || '1' %>"
      data-emit-metadata="<%= theme.giscus.emit_metadata || '0' %>"
      data-input-position="<%= theme.giscus.input_position || 'bottom' %>"
      data-theme="<%= theme.giscus.theme || 'preferred_color_scheme' %>"
      data-lang="<%= theme.giscus.lang || 'zh-CN' %>"
      crossorigin="anonymous"
      async>
    </script>
  </section>
</div>
<% } %>

<!-- ── TOC scroll-spy ── -->
<script>
(function() {
  var toc = document.getElementById('toc');
  if (!toc) return;

  var tocTopOrigin = toc.getBoundingClientRect().top + window.scrollY;
  var tocLinks = toc.querySelectorAll('.toc-link');
  var headings = [];
  tocLinks.forEach(function(link) {
    var href = link.getAttribute('href');
    if (href && href.startsWith('#')) {
      var el = document.getElementById(href.slice(1));
      if (el) headings.push({ el: el, link: link });
    }
  });
  if (!headings.length) return;

  function onScroll() {
    // Fix/unfix TOC
    if (window.scrollY > tocTopOrigin) {
      toc.classList.add('fixed');
    } else {
      toc.classList.remove('fixed');
    }

    // Active heading detection
    var active = null;
    for (var i = 0; i < headings.length; i++) {
      var top = headings[i].el.getBoundingClientRect().top;
      if (top < 120) {
        active = headings[i];
      } else {
        break;
      }
    }
    if (!active && headings.length) active = headings[0];

    tocLinks.forEach(function(l) { l.classList.remove('active'); });
    if (active) active.link.classList.add('active');
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>

