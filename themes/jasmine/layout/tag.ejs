<!-- ── 标签页 ── -->
<span id="toolbox-mobile" class="toolbox-mobile">盒子</span>

<div class="content content-tag">
  <div class="page-header">

    <!-- 面包屑 -->
    <div class="breadcrumb">
      <div class="location">标签</div>
      <i class="icon-location"></i>
    </div>

    <!-- 导航 -->
    <div class="toolbox">
      <a class="toolbox-entry" href="<%= url_for('/') %>">
        <span class="toolbox-entry-text">盒子</span>
        <i class="icon-angle-down">▾</i>
        <span class="icon-home-text"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg></span>
        <span class="toolbox-entry-home-text">主页</span>
      </a>
      <ul class="list-toolbox">
        <% for (var name in theme.nav) { %>
        <li class="item-toolbox">
          <a href="<%= theme.nav[name] %>" <%- theme.nav[name].startsWith('http') ? 'target="_blank" rel="noopener"' : '' %>>
            <%= name %>
          </a>
        </li>
        <% } %>
      </ul>
    </div>

    <!-- 博客信息 -->
    <div class="box-blog-info">
      <a class="avatar" href="<%= url_for('/') %>">
        <img src="<%= url_for(theme.avatar) %>" alt="<%= config.author %>">
      </a>
      <div class="info">
        <div class="name"><%= theme.blog_name || config.title %></div>
        <% if (theme.slogan) { %>
        <div class="slogan"><%= theme.slogan %></div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- 标签药丸 -->
  <section class="tag-box">
    <div class="tag-title">标签</div>
    <div class="tag-list">
      <% site.tags.each(function(tag) { %>
        <a class="tag-item" href="#<%= encodeURIComponent(tag.name.replace(/^#/, '')) %>">
          <span class="tag-name"><%= tag.name.replace(/^#/, '') %></span>
          <span class="tag-size">( <%= tag.posts.length %> )</span>
        </a>
      <% }); %>
    </div>
  </section>

  <!-- 按标签分组的文章列表（Obsidian 式标签系统） -->
  <ul class="list-post">
    <% site.tags.each(function(tag) { %>
      <li id="<%= tag.name.replace(/^#/, '') %>" class="item-category-name item-title item-title-<%= Math.floor(Math.random() * 5) %>">
        <%= tag.name.replace(/^#/, '') %>
        <span class="category-count">( <%= tag.posts.length %> )</span>
      </li>
      <% tag.posts.sort('date', -1).each(function(post) { %>
      <li class="item-post item">
        <span class="post-date"><%= post.date.format('MM-DD') %></span>
        <a class="post-title" href="<%= url_for(post.path) %>"><%= post.title %></a>
      </li>
      <% }); %>
    <% }); %>
  </ul>
</div>

<script>
(function() {
  if (window.location.hash) {
    var id = decodeURIComponent(window.location.hash.slice(1));
    var el = document.getElementById(id);
    if (el) {
      setTimeout(function() { el.scrollIntoView({ behavior: 'smooth' }); }, 100);
    }
  }
})();
</script>

<a id="backTop" class="back-top show" title="回到顶部">▲</a>
